# Ollama model to use (pulled automatically on first start)
OLLAMA_MODEL=llama3.2

# Image generation backend: "mock" (default) or "comfyui"
# Set to "comfyui" and run with --profile gpu for real image generation
IMAGE_BACKEND=mock

# Stable Diffusion settings (only used when IMAGE_BACKEND=comfyui)
SD_MODEL=sd_xl_turbo_1.0_fp16.safetensors
SD_STEPS=4
